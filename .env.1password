# The Worker's secrets, as 1Password references: no values. scripts/push-secrets.sh resolves them with
# `op run` and uploads them with `wrangler secret bulk`. Names carry a SECRET_ prefix so none of them
# (CLOUDFLARE_API_TOKEN above all) is mistaken by wrangler for its own credentials.

# The "protocol-registry Worker" item holds what belongs to this Worker alone
SECRET_GITHUB_APP_ID="op://Infrastructure secrets/protocol-registry Worker/GITHUB_APP_ID"
SECRET_GITHUB_APP_PRIVATE_KEY="op://Infrastructure secrets/protocol-registry Worker/GITHUB_APP_PRIVATE_KEY"
SECRET_GITHUB_WEBHOOK_SECRET="op://Infrastructure secrets/protocol-registry Worker/GITHUB_WEBHOOK_SECRET"
SECRET_SLACK_WEBHOOK_URL="op://Infrastructure secrets/protocol-registry Worker/SLACK_WEBHOOK_URL"
SECRET_MANUAL_TRIGGER_TOKEN="op://Infrastructure secrets/protocol-registry Worker/MANUAL_TRIGGER_TOKEN"

# Publishing credentials, pushed only when PUBLISH_MODE needs them, so a Worker that generates cannot
# change what the registry hostnames serve. Uncomment PINATA_JWT for "pin", both for "live".
# CLOUDFLARE_API_TOKEN is "ops-v3 control web3 hostnames and DNS" (Web3 Hostnames Write on
# centrifuge.io), whose value ops-v3's token reconciler rotates in that item.
# SECRET_PINATA_JWT="op://Infrastructure secrets/protocol-registry Worker/PINATA_JWT"
# SECRET_CLOUDFLARE_API_TOKEN="op://Infrastructure secrets/rtyiofgli57l32pflcbulyskui/password"
