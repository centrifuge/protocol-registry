{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": "../../src/core",
    "outDir": "dist",
    "types": ["node"]
  },
  "files": ["../../src/core/index.ts"]
}
