{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "centrifuge-protocol-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The account that holds the centrifuge.io zone and its registry hostnames
  "account_id": "1a71ac8bbd35fd2bf390fddf66a44294",
  // Served on workers.dev: the GitHub App posts to
  // https://centrifuge-protocol-registry.<account subdomain>.workers.dev/webhooks/github, and nothing
  // else needs a stable URL. Deliveries are checked against the App's webhook secret and the manual
  // endpoints need a bearer token, so being reachable is not access.
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
  },
  // Reconciles the published registries with the live branch every six hours, so a missed webhook or
  // a transient failure is retried without anyone noticing it first
  "triggers": {
    "crons": ["17 */6 * * *"],
  },
  "vars": {
    // Where the env configs live, and the release branch the registries publish from. Cutting a
    // release is a change to SOURCE_BRANCH here.
    "SOURCE_REPO": "centrifuge/protocol-internal",
    "SOURCE_BRANCH": "live-v3.3",
    // How far a publish goes: "shadow" generates and posts what it would publish; "pin" also pins
    // the layer to IPFS, where nothing reads it; "live" also points the registry hostname at it.
    // Any other value is shadow. pin needs PINATA_JWT, live also CLOUDFLARE_API_TOKEN: until then
    // the Worker does not hold them, so it cannot change what the hostnames serve.
    "PUBLISH_MODE": "live",
    "MAINNET_HOSTNAME": "registry.centrifuge.io",
    "TESTNET_HOSTNAME": "registry.testnet.centrifuge.io",
    // centrifuge.io, where both hostnames live
    "CLOUDFLARE_ZONE_ID": "b9a43e7d34e470e7ee9b1f41a34cc726",
  },
  // Published layers by CID (immutable), ABIs by tag (abis/<tag>/<Artifact>.json, written by
  // protocol's build-abis workflow), and each run's generated registries and reports
  "r2_buckets": [
    {
      "binding": "REGISTRY_BUCKET",
      "bucket_name": "centrifuge-protocol-registry",
    },
  ],
  // One run at a time: the publisher coalesces triggers and starts the next run when one finishes
  "durable_objects": {
    "bindings": [{ "name": "PUBLISHER", "class_name": "Publisher" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Publisher"] }],
  "workflows": [
    {
      "name": "centrifuge-protocol-registry-run",
      "binding": "REGISTRY_RUN",
      "class_name": "RegistryRun",
    },
  ],
  // Secrets, uploaded from 1Password by scripts/push-secrets.sh (see README.md, "Setup"):
  //   GITHUB_APP_ID            the App that reads protocol and posts its PR check runs
  //   GITHUB_APP_PRIVATE_KEY   its key in PKCS#8 PEM (`openssl pkcs8 -topk8 -nocrypt -in app.pem`)
  //   GITHUB_WEBHOOK_SECRET    the App's webhook secret
  //   PINATA_JWT               pins layers; PUBLISH_MODE pin and live only
  //   CLOUDFLARE_API_TOKEN     Web3 Hostnames Write on centrifuge.io; PUBLISH_MODE live only
  //   SLACK_WEBHOOK_URL        publishes, refusals and failures
  //   MANUAL_TRIGGER_TOKEN     bearer token for POST /runs (manual runs 404 without it)
}
